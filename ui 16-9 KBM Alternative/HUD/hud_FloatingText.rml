<rml>
    <head>
        <link type="text/rcss" href="../global/globalElements.rcss"/>
        <title>hud_FloatingText</title>
        <style>

            .floating-text
            {
                font-family: "Inria Sans";
                font-size: 3.0vh;
                position: absolute;
                top:0;
                left:0;
                transform: translateX(-50%);
                opacity: 1;
				font-effect: outline(2dp black);
				white-space: nowrap;
            }

            .floating-text.damage
            {
            }

            .damage-pop{
                font-size: 3.5vh;
                animation: .5s elastic-out animation-pop-out;
            }

            .move-up-2
            {
                animation: 2s cubic-out animation-move-up-10;
            }

            .move-up-5
            {
                animation: 5s cubic-out animation-move-up-10;
            }

            .move-up-10
            {
                animation: 10s cubic-out animation-move-up-10;
            }
        </style>
    </head>
    <body class="no-pointer-events">
        <div id="text-container" class="floating-text">
            <span id="text-content"></span>
        </div>
    </body>
</rml>
